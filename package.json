{
  "name": "popdroidcam",
  "version": "1.1.3",
  "packageManager": "pnpm@11.0.9",
  "description": "Turn your Android phone into a high-quality webcam for Linux and Windows",
  "type": "module",
  "main": "dist/desktop/main.js",
  "scripts": {
    "tui": "bun run src/index.tsx",
    "qr": "bun run src/qr-pair.ts",
    "gui": "bun run src/gui/server.ts",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/run-desktop.mjs",
    "desktop": "electron dist/desktop/main.js",
    "dist:linux": "pnpm run desktop:build && electron-builder --linux --publish never",
    "dist:deb": "pnpm run desktop:build && electron-builder --linux deb --publish never",
    "dist:appimage": "pnpm run desktop:build && electron-builder --linux AppImage --publish never",
    "prepare:scrcpy:win": "node scripts/prepare-scrcpy-win.mjs",
    "dist:win": "pnpm run prepare:scrcpy:win && pnpm run desktop:build && electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [
    "webcam",
    "android",
    "linux",
    "windows",
    "scrcpy",
    "v4l2loopback",
    "obs",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "bun-types": "^1.3.5",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.popdroidcam.app",
    "productName": "PopDroidCam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Utility",
      "maintainer": "PopDroidCam",
      "synopsis": "Use your Android phone as a webcam",
      "description": "Turn your Android phone into a high-quality webcam for Linux. No app required on phone - works over USB or WiFi."
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/scrcpy-win64",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "include": "scripts/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    }
  }
}
